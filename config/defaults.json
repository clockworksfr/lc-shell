{
  "language": "auto",
  "wallpaper": { "enabled": true, "directory": "~/Pictures/Wallpapers" },
  "notifications": { "position": "top-right" },
  "clipboard": {
    "enabled": true,
    "position": "bottom",
    "cardSize": "m",
    "dim": true,
    "maxItems": 500,
    "maxDays": 0,
    "keepTagged": true,
    "images": true,
    "maxImageMB": 20,
    "ignoreSensitive": true,
    "ignoreApps": ["org.keepassxc.KeePassXC", "KeePassXC", "1Password", "Bitwarden", "com.bitwarden.desktop"],
    "pasteOnEnter": true,
    "terminals": ["kitty", "foot", "footclient", "Alacritty", "com.mitchellh.ghostty", "org.wezfurlong.wezterm", "org.kde.konsole", "org.gnome.Console", "org.gnome.Ptyxis", "xterm"]
  },
  "screenshot": { "dir": "", "fileName": "screenshot_{date}_{time}", "enterAction": "copy", "copyOnSave": true, "notify": true, "pickWindows": true, "magnifier": true },
  "idle": { "enabled": true, "lock": 600, "screenOff": 900, "lockedScreenOff": 30, "suspend": 0 },
  "lock": { "pamService": "hyprlock", "beforeSleep": true },
  "appearance": {
    "variant": "auto",
    "schedule": { "type": "time", "light": "07:30", "dark": "19:30" },
    "themes": { "normal": "classic", "modules": "classic" },
    "windowBorders": true
  },
  "modes": {
    "normal": {
      "bar": {
        "left": ["workspaces", "window"],
        "center": ["clock"],
        "right": ["tray", "media", "network", "bluetooth", "battery", "volume", "notifications"]
      },
      "osd": { "position": "bottom", "margin": 80 }
    },
    "modules": {
      "osd": { "position": "bottom", "margin": 40 },
      "dashboard": {
        "grid": { "columns": 12, "rows": 4, "gap": 12, "margin": 12 },
        "windows": { "enabled": true, "ignore": [], "only": [] },
        "pages": {
          "default": [
            { "type": "clock",      "x": 0, "y": 0, "w": 2, "h": 2 },
            { "type": "media",      "x": 0, "y": 2, "w": 3, "h": 2 },
            { "type": "vu",         "x": 2, "y": 0, "w": 1, "h": 2 },
            { "type": "window",     "x": 3, "y": 0, "w": 5, "h": 4 },
            { "type": "lyrics",     "x": 8, "y": 0, "w": 2, "h": 4 },
            { "type": "system",     "x": 10, "y": 0, "w": 2, "h": 3 },
            { "type": "workspaces", "x": 10, "y": 3, "w": 2, "h": 1 }
          ]
        }
      }
    }
  },
  "screens": [
    { "match": { "name": "eDP-*" }, "mode": "normal" }
  ]
}
